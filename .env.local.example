# Second Me OAuth（可选；若授权页不可用可改用下方 GitHub 登录）
SECONDME_CLIENT_ID=你的Client_ID
SECONDME_CLIENT_SECRET=你的Client_Secret
SECONDME_REDIRECT_URI=http://localhost:3000/api/auth/callback
# SECONDME_OAUTH_URL=https://go.second.me/oauth/

# GitHub OAuth（推荐，备用登录）
GITHUB_CLIENT_ID=你的GitHub_OAuth_App_Client_ID
GITHUB_CLIENT_SECRET=你的GitHub_OAuth_App_Client_Secret

# 部署时改为线上地址，例如：
# SECONDME_REDIRECT_URI=https://你的域名/api/auth/callback
# GitHub OAuth App 回调：https://你的域名/api/auth/github/callback

# 可选：知乎特别奖接口（需在赛事群申请 AK/SK）
# ZHIHU_ACCESS_KEY=
# ZHIHU_SECRET_KEY=
